{
  "name": "mapine",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Moleculer microservices node template",
  "type": "commonjs",
  "scripts": {
    "prod": "npm run start",
    "dev": "moleculer-runner --repl --hot services/*.service.js  services/**/*.service.js services/**/**/*.service.js",
    "start": "moleculer-runner services/*.service.js  services/**/*.service.js services/**/**/*.service.js",
    "cli": "moleculer connect NATS",
    "ci": "jest --watch",
    "test": "jest --coverage",
    "dc:up": "docker-compose up --build -d",
    "dc:logs": "docker-compose logs -f",
    "dc:down": "docker-compose down"
  },
  "workspaces": [
    "modules"
  ],
  "keywords": [
    "microservices",
    "moleculer"
  ],
  "author": "",
  "devDependencies": {
    "jest": "^27.5.1",
    "jest-cli": "^27.5.1",
    "moleculer-repl": "^0.7.3"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "axios": "^1.8.4",
    "calendaring": "^0.0.8",
    "co": "^4.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "lodash": "^4.17.21",
    "moleculer": "^0.14.26",
    "mongoose": "^8.17.1",
    "osm-pbf-parser": "^2.3.0",
    "osm-pbf-parser-node": "^1.1.4",
    "uuid": "^11.1.0"
  },
  "engines": {
    "node": ">= 16.x.x"
  },
  "jest": {
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "rootDir": "./services",
    "roots": [
      "../test"
    ]
  },
  "main": "moleculer.config.js"
}
